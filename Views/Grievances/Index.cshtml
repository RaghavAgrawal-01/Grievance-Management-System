@model IEnumerable<GrievanceSystem.Models.Grievance>

@{
    ViewData["Title"] = "Grievances List";
}

<h1>Grievances List</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Complaint</a>
</p>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Ticket Number</th>
            <th>Name</th>
            <th>Email</th>
            <th>Subject</th>
            <th>Description</th>
            <th>Status</th>
            <th>Date</th>
            <th>Actions</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @item.TicketNumber
                </td>
                <td>
                    @item.Name
                </td>
                <td>
                    @item.Email
                </td>
                <td>
                    @item.Subject
                </td>
                <td>
                    @item.Description
                </td>
                <td>
                    @item.Status
                </td>
                <td>
                    @item.CreatedAt.ToString("dd-MM-yyyy HH:mm")
                </td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>